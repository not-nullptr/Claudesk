[Unit]
Description=Provision a @NAME@ Claudesk instance for every account that needs one

[Timer]
# A backstop, not the main path: the .path unit fires the moment authd drops a
# request, so this only has to catch a missed event, a failed provision, or a
# deployment whose authd predates the spool.
OnBootSec=30s
OnUnitActiveSec=20s
AccuracySec=5s
Unit=@NAME@-provision.service

[Install]
WantedBy=timers.target
