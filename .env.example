TZ=Asia/Shanghai
PUID=1000
PGID=1001
KVM_GID=104

COWORK_WEB_PORT=15821
COWORK_BRIDGE_ENABLED=1
COWORK_BRIDGE_INTERNAL_PORT=9222

# Largest upload from the web UI (attachments to Code and Cowork, dropped folders),
# in bytes; a K, M or G suffix also works (for example 2G). The limit covers all
# the files of one upload. Files are streamed to disk under /workspace/RemoteUploads,
# so size costs disk, not memory. Default 1 GiB. A reverse proxy in front of the web
# UI must allow bodies this large too (Caddy does by default; nginx needs
# client_max_body_size).
COWORK_UPLOAD_MAX_BYTES=1073741824

# Extra roots the authenticated remote download route
# (GET /api/remote/files/download) may serve from, on top of the workspace
# (/workspace), which is always allowed. Colon- or comma-separated. Paths are
# resolved inside the cowork-bridge container, so a host directory must also be
# bind-mounted into it to be reachable. Leave unset for workspace-only, the
# safe default. Anything listed here becomes remotely readable, so keep it to
# what you actually need and behind the authenticated HTTPS endpoint.
#COWORK_REMOTE_READ_ROOTS=/workspace:/config

# Largest file the remote file pane will open when Desktop's own session reader
# refuses it. Desktop returns null (and the pane shows "Couldn't read this
# file") for any path outside the session's folders or over 10 MiB. The bridge
# re-reads such paths from the roots above; this is the size ceiling for that
# fallback. Matching Desktop's 10 MiB by default. A plain byte count or a K/M/G
# suffix both work (100M = 104857600). The file is held several times over while
# the response is built, so the bridge also clamps this to an eighth of the
# container's memory limit (at most 32 MiB); a larger value asks for a bigger
# preview but cannot take the bridge down -- files past the effective cap open
# in the pane as "preview isn't available" instead. Raise the container's
# CLAUDE_COWORK_BRIDGE_MEMORY_LIMIT as well if you want a bigger cap to take
# effect.
COWORK_REMOTE_SESSION_FILE_MAX_BYTES=10485760

# Largest Office document the bridge will convert for the in-browser file
# preview (the office-preview sidecar runs LibreOffice, the same engine Desktop
# uses). A plain byte count or K/M/G suffix both work; default 52428800 (50 MiB),
# matching Desktop's own preview cap. PDFs are served as-is and are not subject
# to this limit. Raise CLAUDE_OFFICE_PREVIEW_MEMORY_LIMIT below if large or
# complex documents are converted slowly or the sidecar is OOM-killed.
COWORK_REMOTE_PREVIEW_MAX_BYTES=52428800

# Temporary opt-in for editing the official 3P Gateway configuration from the
# remote WebUI. It also enables the official Desktop Developer menu on startup;
# setting it back to 0 disables that menu on the next restart. Keep disabled on
# unauthenticated or unencrypted networks.
CLAUDE_REMOTE_GATEWAY_SETTINGS=0

# High-privilege remote Developer menu actions and the allowlisted file editor
# for MCP logs, claude_desktop_config.json, developer_settings.json, and trace
# downloads. Enable only behind trusted HTTPS authentication such as Authelia.
CLAUDE_REMOTE_DEVELOPER_ACTIONS=0
# Enables the exact official Projects/Spaces, Artifact, browser-file, Memory,
# and Scheduled Tasks mutation methods used by the remote WebUI. Keep this
# behind the authenticated HTTPS endpoint or a trusted LAN/Tailnet.
CLAUDE_REMOTE_INFRASTRUCTURE_ACTIONS=0
# Publishes the official Code/LocalSessions IPC surface. Code commands run in
# the Desktop container and can mutate files mounted under /workspace. On by
# default: the mobile facade's Code tab drives this surface, and the backend
# still requires a signed-in session. Set to 0 to withhold it.
CLAUDE_REMOTE_CODE_ACTIONS=1

# Experimental. Renders ion-dist's browser (claude.ai) chrome — the wordmark,
# the pill Chat/Code tabs and the tall New/Customize rows — instead of the
# Desktop chrome, while keeping this bridge's local IPC data layer. ion-dist
# chooses its shell from the `Claude/<version>` user-agent token the preload
# appends; this drops it (see docs/web-shell.md), and grants the org
# entitlements the web shell's Cowork surface checks. Off by default: the web
# shell surfaces differ from the Desktop ones, and things beyond Chat + Cowork
# (notably the local Code surface and folder browsing) are not wired up yet.
CLAUDE_REMOTE_WEB_SHELL=0

# Offer Cowork's "Skip all approvals" mode. That row is hidden by the org's
# `cowork_settings.skip_approvals_enabled` (default false, an admin-only
# setting) plus the `cowork_bypass_permissions_mode` rollout gate; a self-hosted
# single-user deployment has no admin to flip the first, so with this on the
# bridge answers both as enabled and the composer lists the mode. Skip all
# approvals lets Cowork sessions run with no tool prompts — the same posture as
# the Code surface's bypass mode — so it is a real safety switch. Defaults on
# with CLAUDE_REMOTE_WEB_SHELL=1 (where Cowork is the surface in use); set to 0
# to restore the upstream value. Set to 1 to offer it without the web shell.
# Requires a container restart.
#CLAUDE_REMOTE_COWORK_SKIP_APPROVALS=1

# Name the remote WebUI shows as the signed-in user, in the sidebar user menu and
# as the address in the home greeting ("Back at it, Ada"). Both resolve the same
# way: this override when set, otherwise the name the app already shows for the
# signed-in user — Desktop's own OS app user ("app" in this image). The upstream
# gateway sends no greeting text, which is why the home page would sit on the
# built-in "You're here!" placeholder; the Bridge supplies the official chat and
# code greetings (per weekday, by the visitor's local time) itself.
#CLAUDE_REMOTE_USER_NAME=Ada

# Optional explicit Cowork/Code tool and plugin-CLI egress policy. ["*"] means
# unrestricted destinations subject to the NAS firewall and upstream network.
CLAUDE_EGRESS_ALLOWED_HOSTS_JSON=
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080
CLAUDE_HEADLESS=1
CLAUDE_DISABLE_GPU=1

# Resource policy used by the production headless deployment. The wrapper
# clamps the Cowork VM settings at the Electron IPC boundary, so WebUI feature
# defaults cannot silently raise them again.
CLAUDE_COWORK_VM_MEMORY_GB=2
CLAUDE_COWORK_VM_CPU_COUNT=1
CLAUDE_COWORK_VM_IDLE_MINUTES=30
CLAUDE_COWORK_VM_SCHEDULE_GUARD_MINUTES=10
# Opt in only on a trusted deployment: Bash runs as the container app user and
# no longer has the official Cowork VM filesystem/network isolation.
# Desktop 2.x requires the official Cowork VM; host Bash patches are retired.
CLAUDE_COWORK_HOST_BASH=0
CLAUDE_DESKTOP_MEMORY_LIMIT=3g
CLAUDE_COWORK_BRIDGE_MEMORY_LIMIT=256m

# Memory ceiling for the office-preview sidecar. LibreOffice is the bulk of it;
# a conversion needs a few hundred MB. Kept separate from the bridge so a large
# document cannot disturb the bridge by raising its own limit.
CLAUDE_OFFICE_PREVIEW_MEMORY_LIMIT=1g

# Exact official Desktop package baked into the immutable image. The monthly
# updater changes this only after a staged candidate passes compatibility checks.
CLAUDE_DESKTOP_VERSION=2.9939.4

# Gateway base URL. For a gateway serving POST /v1/messages, this is usually
# the origin without a trailing /v1. The current Tailnet endpoint is:
# http://fn-i3h510-1.tail0292a9.ts.net:3001
CLAUDE_GATEWAY_BASE_URL=
CLAUDE_GATEWAY_API_KEY=
CLAUDE_GATEWAY_AUTH_SCHEME=bearer

# Exact route names accepted by the gateway. The current Claude Desktop validates
# gateway route names, so use a Claude-family alias (for example
# claude-sonnet-minimax-m3) and map that alias to MiniMax-M3 in the gateway.
# Discovery is not used because the current proxy has no GET /v1/models.
CLAUDE_INFERENCE_MODELS_JSON='[{"name":"claude-sonnet-minimax-m3","labelOverride":"MiniMax M3","anthropicFamilyTier":"sonnet","isFamilyDefault":true}]'

# Model the session-title generator is asked to use (Claudesk's bridge and its
# mobile facade). Desktop would otherwise resolve its own small title model
# (claude-haiku-4-5-20251001), which a gateway that carries only the routes
# above does not serve: the request is refused (HTTP 403) and the title fails,
# leaving new sessions titled with their first message. Set a cheap model so
# titles never spend the session's model. It must be one of the names in
# CLAUDE_INFERENCE_MODELS_JSON above: Desktop discards a model it does not
# recognise and falls back to the one the gateway refuses, so a name the gateway
# serves but Desktop's list does not is no better than leaving this empty.
# Left empty, a title request carries the session's own model, and the
# new-session preview in the mobile app has no title to generate from (the first
# message stands in until the session's first reply is titled).
CLAUDE_TITLE_MODEL=

# --- mobile API (v1) -------------------------------------------------------
# Single-user login for the claude.ai-compatible mobile API facade. The app's
# "email code" box takes the current TOTP code from an authenticator app; there
# is no static code and no password. Generate the secret once with
#   node mobile/totp-setup.mjs you@example.com
# add the printed key to your authenticator app, and keep a copy of it: it is
# the only way to log in. The server clock must be accurate (NTP).
CLAUDE_MOBILE_API_EMAIL=
CLAUDE_MOBILE_API_TOTP_SECRET=

# Number of reverse proxies (Caddy) in front of the mobile service. The client
# address used for the lockout is the Nth entry from the right of
# X-Forwarded-For. 0 ignores the header and uses the socket address.
CLAUDE_MOBILE_TRUST_PROXY=1

# fail2ban-style login policy, per client IP (persisted across restarts).
CLAUDE_MOBILE_API_MAX_FAILURES=5
CLAUDE_MOBILE_API_BASE_BAN_SECONDS=600

# Mobile chats run inside Claudesk: the mobile service talks to the bridge in
# front of Claude Desktop, so a phone chat is a Desktop Chat session. It shows up
# in the Claudesk web UI, uses the same system prompt, models, tools and
# attachments, and is edited and retried the same way (rewind and resend). Only
# Chat sessions are reachable from the phone. The default needs no change.
#CLAUDE_MOBILE_DESKTOP_URL=http://claude-desktop:8080

# Show tool calls (Bash, web search, file reads, ...) and their results inline in
# chats. How the iOS app draws them has not been verified on a device yet; set to
# 0 to show only the answer text if they render badly.
CLAUDE_MOBILE_TOOL_BLOCKS=1

# Show the model's reasoning: the reasoning summary for closed-weights models and
# the raw reasoning for open-weights models, as Claudesk's web UI does. Same
# caveat as above; set to 0 to hide it.
CLAUDE_MOBILE_THINKING=1

# Give a new chat a short title written by Claudesk, as the web UI does (one small
# model request per new chat, using Desktop's title generator). Until it arrives,
# and if it fails, the chat is titled with its first message. Set to 0 to skip it.
CLAUDE_MOBILE_TITLES=1

# The plan the account reports to the app: free, pro, max_5x or max_20x. The app
# shows upsells (for Claude Code, for one) on plans that lack a feature, so this
# only changes what the app displays and unlocks; nothing is billed.
CLAUDE_MOBILE_PLAN=max_20x

# Set to 1 to log every request the phone makes (method, path, query names,
# status, and a redacted body for routes that are not implemented) to
# mobile-data/capture.jsonl. Used to find out how the app drives Cowork and
# Claude Code. Turn it off again afterwards.
CLAUDE_MOBILE_CAPTURE=0

# One-shot experiment switch for the new-session environment picker. Leave unset
# (or "both") in normal operation: the facade advertises the Desktop as a cloud
# environment (for the picker's "Cloud environments" section) and as a paired
# bridge. Set to "cloud-only" to withhold the bridge and advertise only the
# cloud record, or "bridge-only" for the reverse, when bisecting which record
# the picker surfaces. Requires a container restart, not just an .env edit.
#CLAUDE_MOBILE_ENVIRONMENT_MODE=both

# Advertise each folder under the workspace root as its own bridge environment
# (default on). A bridge environment is one working directory on a machine, and
# the app's remote folder picker lists a device's directories as environments,
# so this is what makes the built-in folder browser offer the workspace folders
# and run a new session in the picked one. Set to 0 to advertise only the single
# paired device (the previous behaviour). Requires a container restart.
#CLAUDE_MOBILE_ENVIRONMENT_FOLDERS=1

# How many sessions a device directory may hold before the app shows it "at
# capacity" and greys out the new-session button (`Capacity.activeSessionCount`
# vs this). A self-hosted single-user Desktop has no real cap, so the default is
# deliberately high; a small value here makes any directory with that many
# sessions un-startable. Requires a container restart.
#CLAUDE_MOBILE_MAX_SESSIONS=1000

# Whether the app is told it may use the Auto / Bypass permissions modes
# (`GET …/permission_mode_policy`; `false` hides those rows in the composer).
# Bypass runs Code sessions with no tool prompts, so this is a real safety
# switch — set to 0 to hide it again. Requires a container restart.
#CLAUDE_MOBILE_BYPASS_PERMISSIONS=1

# Force every Code session to start in this permission mode, ignoring the app's
# picker: default | acceptEdits | bypassPermissions | dontAsk | plan | auto. The
# app's Code composer has no Bypass row (bypassPermissions is a wire value only),
# so `bypassPermissions` here is how you get prompt-free Code sessions. Unset to
# honour the app. Requires a container restart.
#CLAUDE_MOBILE_PERMISSION_MODE=

# Map the app's "Auto" permission choice onto Desktop's bypassPermissions, so
# picking Auto in the Code composer means no tool prompts (the app has no Bypass
# row to pick directly). Set to 0 to keep Auto as Desktop's own guarded auto
# mode. Requires a container restart.
#CLAUDE_MOBILE_AUTO_IS_BYPASS=1

# Shared secret for the on-device Frida probe (tools/frida/README.md). Setting
# it enables POST /__diag, which the instrumented app build uses to report Swift
# types and thrown errors; the findings are logged as "[mobile-frida] …". Unset
# means the route does not exist at all. Must match the --token the IPA was
# built with. Requires a container restart.
#CLAUDE_MOBILE_FRIDA_TOKEN=
