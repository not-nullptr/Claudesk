TZ=Asia/Shanghai
PUID=1000
PGID=1001
KVM_GID=104

COWORK_WEB_PORT=15821
COWORK_BRIDGE_ENABLED=1
COWORK_BRIDGE_INTERNAL_PORT=9222

# Largest upload from the web UI (attachments to Code and Cowork, dropped folders),
# in bytes; a K, M or G suffix also works (for example 2G). The limit covers all
# the files of one upload. Files are streamed to disk under /workspace/RemoteUploads,
# so size costs disk, not memory. Default 1 GiB. A reverse proxy in front of the web
# UI must allow bodies this large too (Caddy does by default; nginx needs
# client_max_body_size).
COWORK_UPLOAD_MAX_BYTES=1073741824

# Extra roots the authenticated remote download route
# (GET /api/remote/files/download) may serve from, on top of the workspace
# (/workspace), which is always allowed. Colon- or comma-separated. Paths are
# resolved inside the cowork-bridge container, so a host directory must also be
# bind-mounted into it to be reachable. Leave unset for workspace-only, the
# safe default. Anything listed here becomes remotely readable, so keep it to
# what you actually need and behind the authenticated HTTPS endpoint.
#COWORK_REMOTE_READ_ROOTS=/workspace:/config

# Largest file the remote file pane will open when Desktop's own session reader
# refuses it. Desktop returns null (and the pane shows "Couldn't read this
# file") for any path outside the session's folders or over 10 MiB. The bridge
# re-reads such paths from the roots above; this is the size ceiling for that
# fallback. Matching Desktop's 10 MiB by default. A plain byte count or a K/M/G
# suffix both work (100M = 104857600). The file is held several times over while
# the response is built, so the bridge also clamps this to an eighth of the
# container's memory limit (at most 32 MiB); a larger value asks for a bigger
# preview but cannot take the bridge down -- files past the effective cap open
# in the pane as "preview isn't available" instead. Raise the container's
# CLAUDE_COWORK_BRIDGE_MEMORY_LIMIT as well if you want a bigger cap to take
# effect.
COWORK_REMOTE_SESSION_FILE_MAX_BYTES=10485760

# Largest Office document the bridge will convert for the in-browser file
# preview (the office-preview sidecar runs LibreOffice, the same engine Desktop
# uses). A plain byte count or K/M/G suffix both work; default 52428800 (50 MiB),
# matching Desktop's own preview cap. PDFs are served as-is and are not subject
# to this limit. Raise CLAUDE_OFFICE_PREVIEW_MEMORY_LIMIT below if large or
# complex documents are converted slowly or the sidecar is OOM-killed.
COWORK_REMOTE_PREVIEW_MAX_BYTES=52428800

# Temporary opt-in for editing the official 3P Gateway configuration from the
# remote WebUI. It also enables the official Desktop Developer menu on startup;
# setting it back to 0 disables that menu on the next restart. Keep disabled on
# unauthenticated or unencrypted networks.
CLAUDE_REMOTE_GATEWAY_SETTINGS=0

# High-privilege remote Developer menu actions and the allowlisted file editor
# for MCP logs, claude_desktop_config.json, developer_settings.json, and trace
# downloads. Enable only behind trusted HTTPS authentication such as Authelia.
CLAUDE_REMOTE_DEVELOPER_ACTIONS=0
# Enables the exact official Projects/Spaces, Artifact, browser-file, Memory,
# and Scheduled Tasks mutation methods used by the remote WebUI. Keep this
# behind the authenticated HTTPS endpoint or a trusted LAN/Tailnet.
CLAUDE_REMOTE_INFRASTRUCTURE_ACTIONS=0
# Publishes the official Code/LocalSessions IPC surface. Code commands run in
# the Desktop container and can mutate files mounted under /workspace. On by
# default: the mobile facade's Code tab drives this surface, and the backend
# still requires a signed-in session. Set to 0 to withhold it.
CLAUDE_REMOTE_CODE_ACTIONS=1

# Experimental. Renders ion-dist's browser (claude.ai) chrome — the wordmark,
# the pill Chat/Code tabs and the tall New/Customize rows — instead of the
# Desktop chrome, while keeping this bridge's local IPC data layer. ion-dist
# chooses its shell from the `Claude/<version>` user-agent token the preload
# appends; this drops it (see docs/web-shell.md), and grants the org
# entitlements the web shell's Cowork surface checks. Off by default: the web
# shell surfaces differ from the Desktop ones, and things beyond Chat + Cowork
# (notably the local Code surface and folder browsing) are not wired up yet.
CLAUDE_REMOTE_WEB_SHELL=0

# Folder access for Cowork. The Desktop main process collects the folder for
# Cowork's "Choose folder" cards — the `mcp__cowork__request_cowork_directory`
# tool and the other folder-grant flows — with a native OS dialog. In this
# container that dialog renders on a headless display nobody sees, so the button
# appears to do nothing. When this is on, those directory dialogs are handed to
# the browser's in-page picker (the same one "Select folder for local session"
# opens, browsing /workspace), including a "New folder" action, and the chosen
# path is returned to the Desktop as the dialog result. Follows the web shell by
# default (on when CLAUDE_REMOTE_WEB_SHELL=1); set to 1 or 0 to force it.
# See docs/web-shell.md, "Folder access".
CLAUDE_REMOTE_FOLDER_PICKER=

# The login shell: the deployment's front door, serving the renderer's own
# /login — Claude's sign-in page, out of the same bundle the workspace runs —
# before anyone has a session. The instance refuses its whole API in this mode,
# so it can never proxy the Desktop, hold a session or run inference, signed in
# or not; the page appears because the refused bootstrap tells the renderer it
# is signed out, and credentials go straight to authd. Set it on the
# deployment's own instance only, and point the proxy's pre-auth /login and
# /renderer/* at that one (see docs/eva-mode.md, "The login shell"). Off by
# default.
CLAUDE_REMOTE_LOGIN_SHELL=0

# Unified Claude (official 3P `desktopHome` key): "standard" merges Chat and
# Cowork into the single unified home (upstream's "Chat and Cowork unified
# view"); "simple"/"no-vm"/"off" progressively disable surfaces, and an
# unrecognized value fails closed to "off", which removes Chat and Cowork
# entirely — the container refuses anything else at startup. Written into the
# 3P configuration document, or applied to the writable configuration in
# remote-settings mode like the egress and Code flags. The browser follows it:
# the wrapper relays the app's own desktopHome feature to the renderer, which
# paints the unified home when supported. Requires Desktop 2.31226.0 or later
# for the unified home UI itself. Leave unset to keep the Chat/Cowork split
# until upstream turns the unified view on for all orgs.
#CLAUDE_REMOTE_DESKTOP_HOME=standard

# Offer Cowork's "Skip all approvals" mode. That row is hidden by the org's
# `cowork_settings.skip_approvals_enabled` (default false, an admin-only
# setting) plus the `cowork_bypass_permissions_mode` rollout gate; a self-hosted
# single-user deployment has no admin to flip the first, so with this on the
# bridge answers both as enabled and the composer lists the mode. Skip all
# approvals lets Cowork sessions run with no tool prompts — the same posture as
# the Code surface's bypass mode — so it is a real safety switch. Defaults on
# with CLAUDE_REMOTE_WEB_SHELL=1 (where Cowork is the surface in use); set to 0
# to restore the upstream value. Set to 1 to offer it without the web shell.
# Requires a container restart.
#CLAUDE_REMOTE_COWORK_SKIP_APPROVALS=1

# Name the remote WebUI shows as the signed-in user, in the sidebar user menu and
# as the address in the home greeting ("Back at it, Ada"). Both resolve the same
# way: this override when set, otherwise the name the app already shows for the
# signed-in user — Desktop's own OS app user ("app" in this image). The upstream
# gateway sends no greeting text, which is why the home page would sit on the
# built-in "You're here!" placeholder; the Bridge supplies the official chat and
# code greetings (per weekday, by the visitor's local time) itself.
#CLAUDE_REMOTE_USER_NAME=Ada

# Web-shell account identity (CLAUDE_REMOTE_WEB_SHELL=1). A gateway deployment
# fills the account menu and sidebar footer with a synthetic identity — the OS
# app user and an organization named "Gateway" — because there is no real
# Anthropic account behind it. These override just the identity fields on the
# account/organization documents the browser chrome reads, so the account menu
# shows a real name, email, organization and plan and the footer stops reading
# "Gateway". Each is applied only when set; uuids, settings and entitlements are
# left as upstream sent them, so Cowork, Code and the greeting are unaffected.
# Identity only for now — there is no login/logout or per-user separation yet.
#CLAUDE_REMOTE_ACCOUNT_NAME=Ada Lovelace
#CLAUDE_REMOTE_ACCOUNT_EMAIL=ada@example.com
#CLAUDE_REMOTE_ACCOUNT_ORG=Home Lab
#CLAUDE_REMOTE_ACCOUNT_PLAN=Pro
# Profile photo shown in the account menu and footer. Accepts an image URL the
# browser can load (https, or a data: URI to stay self-contained), OR a path to
# an image inside this container (/config/avatar.png): a path is served by the
# bridge itself at /api/remote/account/avatar, same-origin and CSP-clean. The
# file must be png/jpg/jpeg/webp/gif/avif/svg and under 8 MiB. Unset keeps the
# default illustration. This is the uploaded-photo field (avatar_image_url), not
# the built-in preset index (avatar). In Eva Mode this is only a fallback: with
# AUTH_IDENTITY_URL set, each account's own photo — set when the invite is
# accepted and served by authd at /api/auth/avatar/<id> — overrides it.
#CLAUDE_REMOTE_ACCOUNT_AVATAR=https://example.com/me.png
#CLAUDE_REMOTE_ACCOUNT_AVATAR=/config/avatar.png
# Sidebar-footer provider label; defaults to the plan, else the organization.
#CLAUDE_REMOTE_DEPLOYMENT_NAME=Home Lab

# Browser notifications. The bridge relays the notifications Claude Desktop
# decides to show (a finished turn, "needs your input", tool permission cards,
# ...) to the browser and registers a Web Push subscription per browser, so they
# also arrive while no Claudesk tab is open. The subscription state, VAPID key
# and the notification toggles from the settings panel live in the bridge-data
# volume (see compose.yaml; create it writable by PUID:PGID). Push requires a
# secure context: it works on the HTTPS entry, while a plain-HTTP LAN origin
# falls back to in-page notifications. Contact address push services see in the
# VAPID token — a mailto: address or an https: URL of this deployment.
CLAUDE_REMOTE_PUSH_SUBJECT=mailto:claudesk@localhost

# Optional explicit Cowork/Code tool and plugin-CLI egress policy. ["*"] means
# unrestricted destinations subject to the host firewall and upstream network.
CLAUDE_EGRESS_ALLOWED_HOSTS_JSON=
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080
CLAUDE_HEADLESS=1
CLAUDE_DISABLE_GPU=1

# Resource policy used by the production headless deployment. The wrapper
# clamps the Cowork VM settings at the Electron IPC boundary, so WebUI feature
# defaults cannot silently raise them again.
CLAUDE_COWORK_VM_MEMORY_GB=2
CLAUDE_COWORK_VM_CPU_COUNT=1
CLAUDE_COWORK_VM_IDLE_MINUTES=30
CLAUDE_COWORK_VM_SCHEDULE_GUARD_MINUTES=10
# Opt in only on a trusted deployment: Bash runs as the container app user and
# no longer has the official Cowork VM filesystem/network isolation.
# Desktop 2.x requires the official Cowork VM; host Bash patches are retired.
CLAUDE_COWORK_HOST_BASH=0
# The Cowork VM's vsock port is fixed in the app and host-side vsock is global
# per host, so only one VM runs per box unless each instance is moved to a port
# of its own. Off by default: nothing below is set. Read docs/vsock-port.md
# first — the guest side has to be settled before the host is moved, or a guest
# would be pointed at whichever helper still holds the default port.
#   CLAUDESK_VM_VSOCK_PORT          this (the deployment's own) instance
#   CLAUDESK_VM_VSOCK_PORT_BASE     accounts get base + their id
#   CLAUDESK_VM_VSOCK_GUEST_SITES   0 = the guest follows the host; N = patch N
#                                   sites in the account's rootfs.img
# CLAUDESK_VM_VSOCK_PORT=
# CLAUDESK_VM_VSOCK_PORT_BASE=
# CLAUDESK_VM_VSOCK_GUEST_SITES=0
CLAUDE_DESKTOP_MEMORY_LIMIT=3g
CLAUDE_COWORK_BRIDGE_MEMORY_LIMIT=256m

# Memory ceiling for the office-preview sidecar. LibreOffice is the bulk of it;
# a conversion needs a few hundred MB. Kept separate from the bridge so a large
# document cannot disturb the bridge by raising its own limit.
CLAUDE_OFFICE_PREVIEW_MEMORY_LIMIT=1g

# Exact official Desktop package baked into the immutable image. The monthly
# updater changes this only after a staged candidate passes compatibility checks.
CLAUDE_DESKTOP_VERSION=2.31226.1

# Gateway base URL. For a gateway serving POST /v1/messages, this is usually
# the origin without a trailing /v1. The current Tailnet endpoint is:
# http://fn-i3h510-1.tail0292a9.ts.net:3001
CLAUDE_GATEWAY_BASE_URL=
CLAUDE_GATEWAY_API_KEY=
CLAUDE_GATEWAY_AUTH_SCHEME=bearer

# Let the environment own inferenceGatewayBaseUrl inside a writable Gateway
# configuration library (CLAUDE_REMOTE_GATEWAY_SETTINGS=1), which is otherwise
# left as the Gateway panel last wrote it. Off by default, so an endpoint edited
# by hand stays put; provisioned accounts set it, so re-provisioning an account
# can move its endpoint. See scripts/provision-user.sh.
CLAUDE_GATEWAY_ENV_AUTHORITATIVE=0

# Route names the Desktop is offered, as model names or model objects. Leave it
# EMPTY for a gateway that serves GET /v1/models: the Desktop discovers the
# routes from the endpoint and the model picker fills from what it reports, so
# nothing here can fall behind the gateway. Set it to pin the list instead — a
# gateway with no discovery endpoint, or one whose routes you want fixed — and
# use Claude-family aliases, because the Desktop validates route names (for
# example claude-sonnet-minimax-m3, mapped to MiniMax-M3 in the gateway).
# A non-empty value must be a JSON array; a typo is refused at startup rather
# than silently pinning the picker to a route the gateway does not serve.
CLAUDE_INFERENCE_MODELS_JSON=

# Model the session-title generator is asked to use (Claudesk's bridge and its
# mobile facade). Desktop would otherwise resolve its own small title model
# (claude-haiku-4-5-20251001), which a gateway that carries only the routes
# above does not serve: the request is refused (HTTP 403) and the title fails,
# leaving new sessions titled with their first message. Set a cheap model so
# titles never spend the session's model. It must be one of the names in
# CLAUDE_INFERENCE_MODELS_JSON above: Desktop discards a model it does not
# recognise and falls back to the one the gateway refuses, so a name the gateway
# serves but Desktop's list does not is no better than leaving this empty.
# Left empty, a title request carries the session's own model, and the
# new-session preview in the mobile app has no title to generate from (the first
# message stands in until the session's first reply is titled).
CLAUDE_TITLE_MODEL=

# Model used by Auto permission mode's safety classifier, which reviews shell and
# network tool calls (a web fetch, a bash command) before they run. Without this,
# the classifier resolves its own model: it tries a Sonnet 5 default on the
# session's first auto-mode request and, this gateway being a non-Anthropic
# provider, falls back to an Opus model — Opus 5 unless ANTHROPIC_DEFAULT_OPUS_MODEL
# is set. A gateway that carries neither answers the fallback with "temporarily
# unavailable", so auto mode cannot classify anything and blocks the call:
#   claude-opus-5 is temporarily unavailable, so auto mode cannot determine the
#   safety of mcp__workspace__web_fetch
# Set this to a model the gateway serves and the fallback uses it instead. Unlike
# CLAUDE_TITLE_MODEL it does not need to be in CLAUDE_INFERENCE_MODELS_JSON: the
# classifier asks the provider directly, without Desktop's own model list. Claude
# Code exposes no dedicated classifier-model knob (there is no
# CLAUDE_CODE_AUTO_MODE_MODEL), so this is exposed by setting the Opus fallback's
# model (ANTHROPIC_DEFAULT_OPUS_MODEL) before the app starts. It also remaps the
# `opus` alias for the session, which is inert here: the Code surface offers the
# gateway's models, not the alias. Empty leaves the built-in resolution (and the
# failure). Requires a container restart.
CLAUDE_AUTO_MODE_MODEL=

# Model Claude Code's subagents (the Task tool's helpers) are asked to use.
# Claude Code otherwise resolves subagents to its own default model, which a
# gateway carrying only the routes above does not serve; point this at a route
# the gateway serves. CLAUDE_CODE_SUBAGENT_MODEL_FORCE (a boolean) makes that
# choice mandatory rather than best-effort. Both are read by the Code engine
# Desktop spawns; empty leaves Claude Code's own resolution.
CLAUDE_CODE_SUBAGENT_MODEL=deepseek/deepseek-flash
CLAUDE_CODE_SUBAGENT_MODEL_FORCE=1

# --- deployment identity ---------------------------------------------------
# These scope one checkout's stack so a second deployment (say a v2 build beside
# the production one) does not mount the same data, take the same container
# names, or share the same state. Leave them unset for the only deployment on a
# host; set all three for a second one.
#
# Host directory holding /config, /workspace and the per-service state dirs.
CLAUDESK_DATA_ROOT=/opt/claudesk/data
# Host directory backing the persistent-root overlay (Maddie-style stacks).
CLAUDESK_ROOT_STATE=/var/lib/claudesk-root
# Prefix for every container name; e.g. "eva-" gives eva-claude-desktop.
CLAUDESK_NAME_PREFIX=

# deploy.sh also rebuilds the box-level gateway chain (compose.gateway.yaml:
# shitproxy + its Caddy front door) and restarts it, so a shitproxy change on
# this host reaches the running gateway. The chain is shared by every deployment
# on the host, so a second deployment that must not restart it sets
# CLAUDESK_DEPLOY_GATEWAY=0. SHITPROXY_DIR is the host path to the shitproxy
# checkout (default /workspace/shitproxy); the build is skipped, with a notice,
# when that directory is absent.
SHITPROXY_DIR=/workspace/shitproxy
CLAUDESK_DEPLOY_GATEWAY=1

# Per-account instances (see scripts/provision-user.sh). Eva means no Code
# surface. An account gets its own endpoint and credential, and the defaults are
# the box-level chain by name: `gateway` on gateway_net resolves in the container
# through Docker DNS and in the Cowork VM through its container, which is what the
# VM — the thing that makes the model calls — needs. A loopback URL cannot work
# there: inside the guest it resolves to the guest.
#
# The key is the account's own gateway identity, minted by authd and reported by
# `authd --show` as `gateway_key`; scripts/provision-user.sh uses it instead of
# anything set here. The box gateway (shitproxy) resolves it to that account's
# own upstream key, so an account's key never has to be an upstream key, and the
# x-api-key scheme keeps it from being sent as a bearer token the router would
# reject. CLAUDESK_ACCOUNT_GATEWAY_API_KEY is only a fallback for an authd too old
# to report one. Override the URL and scheme to send accounts somewhere else.
CLAUDESK_ACCOUNT_GATEWAY_URL=http://gateway:4000
CLAUDESK_ACCOUNT_GATEWAY_API_KEY=sk-local
CLAUDESK_ACCOUNT_GATEWAY_AUTH_SCHEME=x-api-key
CLAUDESK_ACCOUNT_CODE_ACTIONS=0

# Operator scope for a provisioned account. A provisioned account runs this same
# compose.yaml with this same .env, so it inherits every value below unless it is
# scoped here. The values that must not be inherited are: the writable
# Gateway/inference configuration library (CLAUDE_REMOTE_GATEWAY_SETTINGS) — so an
# end user can neither see that page nor edit the endpoint or credential through
# the API, while its own endpoint still comes from the environment; the Developer
# menu's privileged actions and its editor for claude_desktop_config.json,
# developer_settings.json, MCP logs and trace downloads
# (CLAUDE_REMOTE_DEVELOPER_ACTIONS); the Projects/Spaces, Artifact, browser-file,
# Memory and Scheduled-Tasks mutations (CLAUDE_REMOTE_INFRASTRUCTURE_ACTIONS); and
# the extra download roots (COWORK_REMOTE_READ_ROOTS) — an account reads its own
# workspace and nothing else. A provisioned account gets none of them; an account
# whose role is Admin keeps the deployment's own setting instead. Set any to force
# one value for every account regardless of role. Empty means the role decides.
CLAUDESK_ACCOUNT_GATEWAY_SETTINGS=
CLAUDESK_ACCOUNT_DEVELOPER_ACTIONS=
CLAUDESK_ACCOUNT_INFRASTRUCTURE_ACTIONS=
CLAUDESK_ACCOUNT_READ_ROOTS=

# First host port handed to a provisioned account (15901 + the account id).
CLAUDESK_USER_PORT_BASE=15901

# --- auth service (Eva Mode) ----------------------------------------------
# The account service behind the login and admin pages. It owns users, sessions
# and invites, and answers the reverse proxy's forward_auth. Accounts are created
# by an admin, who gets a one-time invite link shown once; the invitee sets their
# own password and their browser timezone when they accept.
#
# First admin: set this before the first start. While no admin exists the service
# creates this account and prints its one-time invite link to the log exactly once
# (docker compose logs claude-authd); accept it, then clear the variable.
AUTH_BOOTSTRAP_ADMIN_EMAIL=

# Loopback port the reverse proxy forwards /login, /accept-invite and /admin to.
AUTH_PORT=15830

# The reverse proxy terminates TLS, so the session cookie is Secure. Set 0 only
# for a plain-HTTP local test.
AUTH_COOKIE_SECURE=1

# Trusted reverse proxies in front of the service; the login throttle reads the
# client address this many entries from the right of X-Forwarded-For.
AUTH_TRUST_PROXY=1

# Session and invite lifetimes.
AUTH_SESSION_TTL_DAYS=30
AUTH_INVITE_TTL_HOURS=72

# Per-user upstream API keys. The invitee supplies their own key when they accept
# (required), and it is what their inference goes upstream with instead of the
# operator's. The instance sends the account's opaque gateway identity to the box
# gateway, which asks authd (over the internal route /internal/gateway/resolve)
# for that account's key. Set this shared secret to the same value as shitproxy's
# GATEWAY_RESOLVER_SECRET (in /etc/shitproxy/gateway.env). Empty disables the
# route, leaving every account on the operator's key. A caller authd does not
# recognise keeps using shitproxy's UPSTREAM_API_KEY, so other deployments sharing
# the gateway are unaffected — keep that key set for them.
AUTH_GATEWAY_SECRET=

# When set (e.g. http://authd:8080), the bridge resolves the signed-in user from
# the auth service per request, so the sidebar, greeting and profile photo read as
# that person. Their name and photo are set when they accept their invite and
# served by authd (GET /api/auth/avatar/<id>, 404 → the default mark). Empty keeps
# the single env-configured identity (the default behaviour). Provisioned accounts
# set this to http://authd:8080 automatically (see scripts/provision-user.sh).
AUTH_IDENTITY_URL=

# --- mobile API (v1) -------------------------------------------------------
# Single-user login for the claude.ai-compatible mobile API facade. The app's
# "email code" box takes the current TOTP code from an authenticator app; there
# is no static code and no password. Generate the secret once with
#   node mobile/totp-setup.mjs you@example.com
# add the printed key to your authenticator app, and keep a copy of it: it is
# the only way to log in. The server clock must be accurate (NTP).
CLAUDE_MOBILE_API_EMAIL=
CLAUDE_MOBILE_API_TOTP_SECRET=

# Number of reverse proxies (Caddy) in front of the mobile service. The client
# address used for the lockout is the Nth entry from the right of
# X-Forwarded-For. 0 ignores the header and uses the socket address.
CLAUDE_MOBILE_TRUST_PROXY=1

# fail2ban-style login policy, per client IP (persisted across restarts).
CLAUDE_MOBILE_API_MAX_FAILURES=5
CLAUDE_MOBILE_API_BASE_BAN_SECONDS=600

# Mobile chats run inside Claudesk: the mobile service talks to the bridge in
# front of Claude Desktop, so a phone chat is a Desktop Chat session. It shows up
# in the Claudesk web UI, uses the same system prompt, models, tools and
# attachments, and is edited and retried the same way (rewind and resend). Only
# Chat sessions are reachable from the phone. The default needs no change.
#CLAUDE_MOBILE_DESKTOP_URL=http://claude-desktop:8080

# Show tool calls (Bash, web search, file reads, ...) and their results inline in
# chats. How the iOS app draws them has not been verified on a device yet; set to
# 0 to show only the answer text if they render badly.
CLAUDE_MOBILE_TOOL_BLOCKS=1

# Show the model's reasoning: the reasoning summary for closed-weights models and
# the raw reasoning for open-weights models, as Claudesk's web UI does. Same
# caveat as above; set to 0 to hide it.
CLAUDE_MOBILE_THINKING=1

# Give a new chat a short title written by Claudesk, as the web UI does (one small
# model request per new chat, using Desktop's title generator). Until it arrives,
# and if it fails, the chat is titled with its first message. Set to 0 to skip it.
CLAUDE_MOBILE_TITLES=1

# The plan the account reports to the app: free, pro, max_5x or max_20x. The app
# shows upsells (for Claude Code, for one) on plans that lack a feature, so this
# only changes what the app displays and unlocks; nothing is billed.
CLAUDE_MOBILE_PLAN=max_20x

# Set to 1 to log every request the phone makes (method, path, query names,
# status, and a redacted body for routes that are not implemented) to
# mobile-data/capture.jsonl. Used to find out how the app drives Cowork and
# Claude Code. Turn it off again afterwards.
CLAUDE_MOBILE_CAPTURE=0

# One-shot experiment switch for the new-session environment picker. Leave unset
# (or "both") in normal operation: the facade advertises the Desktop as a cloud
# environment (for the picker's "Cloud environments" section) and as a paired
# bridge. Set to "cloud-only" to withhold the bridge and advertise only the
# cloud record, or "bridge-only" for the reverse, when bisecting which record
# the picker surfaces. Requires a container restart, not just an .env edit.
#CLAUDE_MOBILE_ENVIRONMENT_MODE=both

# Advertise each folder under the workspace root as its own bridge environment
# (default on). A bridge environment is one working directory on a machine, and
# the app's remote folder picker lists a device's directories as environments,
# so this is what makes the built-in folder browser offer the workspace folders
# and run a new session in the picked one. Set to 0 to advertise only the single
# paired device (the previous behaviour). Requires a container restart.
#CLAUDE_MOBILE_ENVIRONMENT_FOLDERS=1

# How many sessions a device directory may hold before the app shows it "at
# capacity" and greys out the new-session button (`Capacity.activeSessionCount`
# vs this). A self-hosted single-user Desktop has no real cap, so the default is
# deliberately high; a small value here makes any directory with that many
# sessions un-startable. Requires a container restart.
#CLAUDE_MOBILE_MAX_SESSIONS=1000

# Whether the app is told it may use the Auto / Bypass permissions modes
# (`GET …/permission_mode_policy`; `false` hides those rows in the composer).
# Bypass runs Code sessions with no tool prompts, so this is a real safety
# switch — set to 0 to hide it again. Requires a container restart.
#CLAUDE_MOBILE_BYPASS_PERMISSIONS=1

# Force every Code session to start in this permission mode, ignoring the app's
# picker: default | acceptEdits | bypassPermissions | dontAsk | plan | auto. The
# app's Code composer has no Bypass row (bypassPermissions is a wire value only),
# so `bypassPermissions` here is how you get prompt-free Code sessions. Unset to
# honour the app. Requires a container restart.
#CLAUDE_MOBILE_PERMISSION_MODE=

# Map the app's "Auto" permission choice onto Desktop's bypassPermissions, so
# picking Auto in the Code composer means no tool prompts (the app has no Bypass
# row to pick directly). Set to 0 to keep Auto as Desktop's own guarded auto
# mode. Requires a container restart.
#CLAUDE_MOBILE_AUTO_IS_BYPASS=1

# Shared secret for the on-device Frida probe (tools/frida/README.md). Setting
# it enables POST /__diag, which the instrumented app build uses to report Swift
# types and thrown errors; the findings are logged as "[mobile-frida] …". Unset
# means the route does not exist at all. Must match the --token the IPA was
# built with. Requires a container restart.
#CLAUDE_MOBILE_FRIDA_TOKEN=
