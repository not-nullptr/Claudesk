     def _create_decompiler_pool(self, program: "Program") -> DecompilerPool:
         pool_size = 2 if self.threaded else 1
+        if self.threaded:
+            # Index workers decompile concurrently and each holds a slot for the
+            # whole function, so the pool must cover that fan-out plus ordinary
+            # tool calls (see PYGHIDRA_INDEX_WORKERS in indexing_mixin).
+            try:
+                pool_size = max(pool_size, int(os.environ["PYGHIDRA_DECOMPILER_POOL"]))
+            except (KeyError, ValueError):
+                pass
         return DecompilerPool(lambda: self.setup_decompiler(program), size=pool_size)
 
