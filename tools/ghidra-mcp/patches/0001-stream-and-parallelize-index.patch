+        # Bodies are streamed to Chroma in batches rather than accumulated for
+        # the whole binary. Retaining every decompiled body makes peak RSS scale
+        # with the binary -- hundreds of thousands of functions on a large
+        # Mach-O -- which exhausts small containers before the first add.
+        docs: list[str] = []
+        ids: list[str] = []
+        metadatas: list[dict] = []
+        indexed = 0
+
+        def flush() -> None:
+            nonlocal indexed
+            if not docs:
+                return
+            collection.add(documents=docs, metadatas=metadatas, ids=ids)
+            indexed += len(docs)
+            docs.clear()
+            ids.clear()
+            metadatas.clear()
+
+        def decompile(func: Function) -> tuple[Any, Exception | None]:
+            try:
+                return (
+                    tools.decompile_function(
+                        func, timeout=DEFAULT_DECOMPILE_TIMEOUT_SECONDS
+                    ),
+                    None,
+                )
+            except Exception as e:
+                return None, e
+
+        def consume(func: Function, decompiled: Any, error: Exception | None) -> None:
+            if error is not None:
+                logger.error(
+                    "Failed to decompile %s: %s", func.getSymbol().getName(True), error
+                )
+                return
+            docs.append(decompiled.code)
+            ids.append(decompiled.name)
+            metadatas.append(
+                {"function_name": decompiled.name, "entry_point": str(func.getEntryPoint())}
+            )
+            if len(docs) >= batch_size:
